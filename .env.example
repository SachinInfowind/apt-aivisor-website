# Strapi CMS — sibling project: ../apt-cms
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_REVALIDATE_SECRET=
PREVIEW_SECRET=

# Optional: hostname of a hosted Strapi's media/uploads (for next/image remotePatterns)
STRAPI_MEDIA_HOSTNAME=
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Career page "Express interest" form: a token that can ONLY presign a resume upload and
# create a career application. Create it in the CMS: npm run create-website-api-token
STRAPI_CAREER_API_TOKEN=

# Design Partner form's Business Email "Verify Now": a token that can ONLY request a
# verification email and check a token's status. Create it in the CMS:
# npm run create-email-verification-token
STRAPI_EMAIL_VERIFICATION_API_TOKEN=

# AWS WAF bot protection (replaces Google reCAPTCHA) — off by default (local dev).
# Set ENABLE to "true" only on a deployment that sits behind a WAF web ACL with a Challenge /
# CAPTCHA rule on the form endpoints. Both values are public (inlined at build time), so changing
# them needs a rebuild. INTEGRATION_URL: WAF console → Web ACLs → <acl> → Application integration
# → JavaScript SDK.
NEXT_PUBLIC_ENABLE_AWS_WAF=false
NEXT_PUBLIC_AWS_WAF_INTEGRATION_URL=
