# Strapi CMS — sibling project: ../apt-cms
STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=
STRAPI_REVALIDATE_SECRET=
PREVIEW_SECRET=

# Optional: hostname of a hosted Strapi's media/uploads (for next/image remotePatterns)
STRAPI_MEDIA_HOSTNAME=
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# Career page "Express interest" form: a token that can ONLY presign a resume upload and
# create a career application. Create it in the CMS: npm run create-website-api-token
STRAPI_CAREER_API_TOKEN=

# Google reCAPTCHA v3 — create keys at google.com/recaptcha/admin (type: score based v3)
# The site key is public (sent to the browser); the secret key must stay server-side only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
